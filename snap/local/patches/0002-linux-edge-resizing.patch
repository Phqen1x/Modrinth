+#[cfg(target_os = "linux")]
+mod linux_resize;
+
 #[cfg(feature = "updater")]
 mod updater_impl;
 #[cfg(not(feature = "updater"))]
@@ -296,6 +299,11 @@ fn main() {
                 ));
             });
 
+            #[cfg(target_os = "linux")]
+            if let Some(window) = app.get_window("main") {
+                linux_resize::attach(&window);
+            }
+
             #[cfg(not(target_os = "linux"))]
             if let Some(window) = app.get_window("main")
                 && let Err(e) = window.set_shadow(true)
